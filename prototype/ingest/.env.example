# Enable Banking application (control panel → your app)
EB_APP_ID=00000000-0000-0000-0000-000000000000
# Path to the private key .pem downloaded when you created the app. Keep it OUTSIDE this repo.
EB_PRIVATE_KEY_PATH=~/.config/ai-finance-coach/eb-private-key.pem
# Must exactly match one of the redirect URLs whitelisted in the app.
EB_REDIRECT_URL=https://localhost:8443/callback
