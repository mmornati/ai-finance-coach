# Keep personal data, keys and local state out of the build context (and so out of every image layer).
.git
.gitignore
.venv
**/__pycache__
.pytest_cache
.ruff_cache
node_modules
web/node_modules
web/dist
src/coach/api/static
data
**/data
memory
coach-home
secrets
backups
config.toml
config/taxonomy.yaml
config/rules.yaml
.env
.env.*
*.pem
*.key
*.db
*.enc
*.bak
.claude
docs
tests
evals
prototype
